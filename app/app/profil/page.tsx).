"use client";

import { useState, useEffect } from "react";
import { useRouter } from "next/navigation";
import Link from "next/link";
import { supabase } from "../../lib/supabase";

export default function ProfilPage() {
  const router = useRouter();
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [userId, setUserId] = useState<string | null>(null);
  const [role, setRole] = useState<"client" | "vendeur">("client");
  const [email, setEmail] = useState("");
  const [fullName, setFullName] = useState("");
  const [shopName, setShopName] = useState("");
  const [sellerStatus, setSellerStatus] = useState<"particulier" | "professionnel">("particulier");
  const [birthDate, setBirthDate] = useState("");
  const [vatNumber, setVatNumber] = useState("");
  const [phone, setPhone] = useState("");
  const [address, setAddress] = useState("");
  const [postalCode, setPostalCode] = useState("");
  const [city, setCity] = useState("");
  const [stripeAccountId, setStripeAccountId] = useState("");
  const [message, setMessage] = useState<{ text: string; type: "success" | "error" } | null>(null);

  useEffect(() => {
    const loadProfile = async () => {
      const { data: { user } } = await supabase.auth.getUser();

      if (!user) {
        router.push("/connexion");
        return;
      }

      setUserId(user.id);
      setEmail(user.email || "");

      const { data: profile } = await supabase
        .from("profiles")
        .select("*")
        .eq("id", user.id)
        .single();

      if (profile) {
        setRole(profile.role || "client");
        setFullName(profile.full_name || "");
        setShopName(profile.shop_name || "");
        setSellerStatus(profile.seller_status || "particulier");
        setBirthDate(profile.birth_date || "");
        setVatNumber(profile.vat_number || "");
        setPhone(profile.phone || "");
        setAddress(profile.address || "");
        setPostalCode(profile.postal_code || "");
        setCity(profile.city || "");
        setStripeAccountId(profile.stripe_account_id || "");
      }
      setLoading(false);
    };

    loadProfile();
  }, [router]);

  const handleSave = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!userId) return;
    setSaving(true);
    setMessage(null);

    const { error } = await supabase
      .from("profiles")
      .update({
        full_name: fullName,
        shop_name: role === "vendeur" ? shopName : null,
        seller_status: role === "vendeur" ? sellerStatus : null,
        birth_date: birthDate || null,
        vat_number: role === "vendeur" && vatNumber ? vatNumber : null,
        phone,
        address,
        postal_code: postalCode,
        city,
      })
      .eq("id", userId);

    if (!error) {
      setMessage({
        text: "Vos informations ont bien été enregistrées ! Vous pouvez maintenant accéder à votre espace.",
        type: "success",
      });
    } else {
      setMessage({ text: "Erreur : " + error.message, type: "error" });
    }
    setSaving(false);
  };

  const handleLogout = async () => {
    await supabase.auth.signOut();
    router.push("/");
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-stone-50 flex items-center justify-center text-stone-500">
        Chargement de votre fiche profil...
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-stone-50 text-stone-900">
      <header className="bg-white border-b border-stone-200 sticky top-0 z-10">
        <div className="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
          <Link href="/" className="text-xl font-extrabold tracking-tight text-stone-900">
            AVENUE DES <span className="text-amber-600">CRÉATEURS</span>
          </Link>
          <nav className="flex items-center gap-5 text-sm font-medium">
            <Link href="/" className="text-stone-600 hover:text-stone-900">
              Accueil
            </Link>
            <Link href="/boutique" className="text-stone-600 hover:text-stone-900">
              Boutique
            </Link>
            {role === "vendeur" && (
              <Link href="/vendeur" className="text-amber-700 font-bold hover:text-amber-800">
                Aller à mon Espace Vendeur →
              </Link>
            )}
            <button
              onClick={handleLogout}
              className="text-red-600 hover:text-red-700 font-semibold"
            >
              Déconnexion
            </button>
          </nav>
        </div>
      </header>

      <main className="max-w-3xl mx-auto px-6 py-10">
        <div className="mb-8">
          <span className="inline-block bg-amber-100 text-amber-800 text-xs font-bold px-3 py-1 rounded-full uppercase mb-2">
            Compte {role === "vendeur" ? "Vendeur / Créateur" : "Client / Acheteur"}
          </span>
          <h1 className="text-3xl font-extrabold text-stone-900">Ma Fiche Profil &amp; Coordonnées</h1>
          <p className="text-stone-600 text-sm mt-1">{email}</p>
        </div>

        {message && (
          <div
            className={`mb-6 p-4 rounded-xl text-sm font-medium ${
              message.type === "success"
                ? "bg-emerald-50 text-emerald-800 border border-emerald-200"
                : "bg-red-50 text-red-800 border border-red-200"
            }`}
          >
            {message.text}
          </div>
        )}

        <form onSubmit={handleSave} className="bg-white p-8 rounded-2xl border border-stone-200 shadow-sm flex flex-col gap-5">
          <h2 className="text-lg font-bold border-b border-stone-100 pb-3">
            1. Identité &amp; Coordonnées obligatoires
          </h2>

          <div className="grid sm:grid-cols-2 gap-4">
            <div>
              <label className="block text-xs font-semibold text-stone-600 mb-1">
                Nom et prénom complets *
              </label>
              <input
                type="text"
                value={fullName}
                onChange={(e) => setFullName(e.target.value)}
                required
                className="w-full p-2.5 border border-stone-300 rounded-xl text-sm"
              />
            </div>

            <div>
              <label className="block text-xs font-semibold text-stone-600 mb-1">
                Numéro de téléphone *
              </label>
              <input
                type="tel"
                placeholder="Ex: 0470 12 34 56"
                value={phone}
                onChange={(e) => setPhone(e.target.value)}
                required
                className="w-full p-2.5 border border-stone-300 rounded-xl text-sm"
              />
            </div>
          </div>

          {role === "vendeur" && (
            <>
              <div className="grid sm:grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs font-semibold text-stone-600 mb-1">
                    Nom de votre boutique / marque *
                  </label>
                  <input
                    type="text"
                    value={shopName}
                    onChange={(e) => setShopName(e.target.value)}
                    required
                    className="w-full p-2.5 border border-stone-300 rounded-xl text-sm"
                  />
                </div>

                <div>
                  <label className="block text-xs font-semibold text-stone-600 mb-1">
                    Date de naissance (obligatoire) *
                  </label>
                  <input
                    type="date"
                    value={birthDate}
                    onChange={(e) => setBirthDate(e.target.value)}
                    required
                    className="w-full p-2.5 border border-stone-300 rounded-xl text-sm"
                  />
                </div>
              </div>

              <div className="bg-stone-50 p-4 rounded-xl border border-stone-200">
                <label className="block text-xs font-bold text-stone-700 mb-2">
                  Votre statut actuel :
                </label>
                <div className="grid sm:grid-cols-2 gap-3 mb-3">
                  <button
                    type="button"
                    onClick={() => setSellerStatus("particulier")}
                    className={`p-3 rounded-xl border text-left text-xs transition ${
                      sellerStatus === "particulier"
                        ? "border-amber-600 bg-amber-50 text-amber-900 font-bold"
                        : "border-stone-200 bg-white text-stone-600"
                    }`}
                  >
                    🌱 Créateur débutant / Particulier
                    <span className="block font-normal text-stone-500 mt-0.5">
                      Pas encore de numéro BCE / TVA
                    </span>
                  </button>

                  <button
                    type="button"
                    onClick={() => setSellerStatus("professionnel")}
                    className={`p-3 rounded-xl border text-left text-xs transition ${
                      sellerStatus === "professionnel"
                        ? "border-amber-600 bg-amber-50 text-amber-900 font-bold"
                        : "border-stone-200 bg-white text-stone-600"
                    }`}
                  >
                    🏢 Indépendant / Société
                    <span className="block font-normal text-stone-500 mt-0.5">
                      Inscrit à la BCE avec numéro de TVA
                    </span>
                  </button>
                </div>

                <div>
                  <label className="block text-xs font-semibold text-stone-600 mb-1">
                    Numéro BCE / TVA {sellerStatus === "professionnel" ? "*" : "(facultatif pour débuter)"}
                  </label>
                  <input
                    type="text"
